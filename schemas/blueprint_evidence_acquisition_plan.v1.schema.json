{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-to-code.evidence-acquisition-plan/v1",
  "title": "Blueprint Evidence Acquisition Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "solverId", "actions", "semanticDigest"],
  "properties": {
    "schema": {"const": "blueprint-to-code.evidence-acquisition-plan/v1"},
    "solverId": {"type": "string", "pattern": "^solver://[0-9a-f]{32}$"},
    "actions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/action"}},
    "semanticDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "problemId", "requirementIds", "actionKind", "sourceKind", "status", "automatable", "requiresUserAction", "assetCandidate", "reason", "instructions", "dependsOn"],
      "properties": {
        "actionId": {"type": "string", "pattern": "^action://[0-9a-f]{24}$"},
        "problemId": {"type": "string"},
        "requirementIds": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
        "actionKind": {"enum": ["PUBLISH_CURRENT_V4_EVIDENCE", "REBUILD_BINARY_V4", "RUN_WC_SNAPSHOT", "CAPTURE_GRAPH_CLIPBOARD", "IMPORT_LOCALIZATION", "IMPORT_DATASET", "PROVIDE_ASSET", "PROVIDE_MOD_ASSET", "PROVIDE_NATIVE_SOURCE", "SELECT_ASSET_CANDIDATE"]},
        "sourceKind": {"type": "string", "maxLength": 64},
        "status": {"enum": ["READY", "BLOCKED_BY_TARGET_SELECTION", "BLOCKED_BY_USER_INPUT", "AVAILABLE_TO_AUTOMATE", "NOT_SUPPORTED", "COMPLETED"]},
        "automatable": {"type": "boolean"},
        "requiresUserAction": {"type": "boolean"},
        "assetCandidate": {"type": "object"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "instructions": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "dependsOn": {"type": "array", "maxItems": 16, "items": {"type": "string"}}
      }
    }
  }
}
