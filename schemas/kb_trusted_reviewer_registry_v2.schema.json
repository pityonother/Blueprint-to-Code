{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pityonother.github.io/Blueprint-to-Code/schemas/kb_trusted_reviewer_registry_v2.schema.json",
  "title": "ARK KB trusted reviewer and operator registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registryId",
    "registryVersion",
    "trustContext",
    "generatedAt",
    "reviewers",
    "registryVersionSha256"
  ],
  "properties": {
    "schema": {
      "const": "ark-kb-trusted-reviewer-registry/v2"
    },
    "registryId": {
      "type": "string",
      "minLength": 1
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "trustContext": {
      "enum": ["PRODUCTION", "TEST_ONLY"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "registryVersionSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerId",
        "publicKeyAlgorithm",
        "publicKeyBase64",
        "publicKeyFingerprint",
        "allowedRoles",
        "validFrom",
        "validUntil",
        "revokedAt",
        "registryEntrySha256"
      ],
      "properties": {
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "publicKeyAlgorithm": {
          "const": "Ed25519"
        },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44
        },
        "publicKeyFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REVIEWER",
              "ADJUDICATOR",
              "BURN_IN_OPERATOR"
            ]
          }
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "registryEntrySha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
