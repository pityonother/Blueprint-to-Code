{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pityonother.github.io/Blueprint-to-Code/schemas/kb_gold_review_common_v1.schema.json",
  "title": "ARK KB independent gold review common protocol v1",
  "oneOf": [
    {"$ref": "#/$defs/reviewPack"},
    {"$ref": "#/$defs/reviewReceipt"},
    {"$ref": "#/$defs/validationResult"},
    {"$ref": "#/$defs/reviewerRegistry"},
    {"$ref": "#/$defs/queryReviewProvenance"},
    {"$ref": "#/$defs/registrationReviewSource"},
    {"$ref": "#/$defs/roleReviewSource"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "payload", "candidateSha256"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "payload": {
          "type": "object",
          "description": "Blind reviewer payload. Current expected answers, routes, predictions, roles, and confidence fields are forbidden by the validator."
        },
        "candidateSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "registrationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerUri",
        "targetUri",
        "registrationType",
        "sourceProperty",
        "evidenceUri",
        "sourceKind"
      ],
      "properties": {
        "ownerUri": {"type": "string", "minLength": 1},
        "targetUri": {"type": "string", "minLength": 1},
        "registrationType": {"type": "string", "minLength": 1},
        "sourceProperty": {"type": "string", "minLength": 1},
        "evidenceUri": {"type": "string", "minLength": 1},
        "sourceKind": {"type": "string", "minLength": 1}
      }
    },
    "registrationSourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "payload"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "payload": {"$ref": "#/$defs/registrationPayload"}
      }
    },
    "registrationReviewSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "generatedFromCore",
        "generatedFromClassifier",
        "sourceIdentity",
        "candidates"
      ],
      "properties": {
        "schema": {
          "const": "ark-kb-registration-review-source/v1"
        },
        "kind": {"const": "registration"},
        "generatedFromCore": {"const": false},
        "generatedFromClassifier": {"const": false},
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseSchema",
            "generatedAt",
            "sourceInventoryId",
            "sourceFingerprint",
            "sourceRowSetSha256",
            "sourceRowCount"
          ],
          "properties": {
            "databaseSchema": {
              "enum": [
                "blueprint-to-code-kb-discovery/v1",
                "blueprint-to-code-kb-discovery/v2"
              ]
            },
            "generatedAt": {"type": "string", "format": "date-time"},
            "sourceInventoryId": {"type": "string", "minLength": 1},
            "sourceFingerprint": {"$ref": "#/$defs/sha256"},
            "sourceRowSetSha256": {"$ref": "#/$defs/sha256"},
            "sourceRowCount": {"type": "integer", "minimum": 1}
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/registrationSourceCandidate"}
        }
      }
    },
    "degreeBucket": {
      "type": "string",
      "enum": ["ZERO", "LOW", "MEDIUM", "HIGH"]
    },
    "roleDegreeCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencer",
        "descendant",
        "mapUsage",
        "registryUsage",
        "componentReuse",
        "crossDomain"
      ],
      "properties": {
        "referencer": {"$ref": "#/$defs/degreeBucket"},
        "descendant": {"$ref": "#/$defs/degreeBucket"},
        "mapUsage": {"$ref": "#/$defs/degreeBucket"},
        "registryUsage": {"$ref": "#/$defs/degreeBucket"},
        "componentReuse": {"$ref": "#/$defs/degreeBucket"},
        "crossDomain": {"$ref": "#/$defs/degreeBucket"}
      }
    },
    "rolePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalUri",
        "assetName",
        "assetClassPath",
        "blueprintKind",
        "parentClassPath",
        "nativeParentClassPath",
        "domain",
        "pluginOrDlc",
        "assetType",
        "ancestryCohort",
        "degreeCohort",
        "identityStatus",
        "identitySourceKind",
        "evidenceFreshness",
        "evidenceUri",
        "selectionCohort"
      ],
      "properties": {
        "canonicalUri": {"type": "string", "minLength": 1},
        "assetName": {"type": "string", "minLength": 1},
        "assetClassPath": {"type": "string", "minLength": 1},
        "blueprintKind": {"type": "string", "minLength": 1},
        "parentClassPath": {"type": "string", "minLength": 1},
        "nativeParentClassPath": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "pluginOrDlc": {"type": "string", "minLength": 1},
        "assetType": {"type": "string", "minLength": 1},
        "ancestryCohort": {"type": "string", "minLength": 1},
        "degreeCohort": {"$ref": "#/$defs/roleDegreeCohort"},
        "identityStatus": {"type": "string", "minLength": 1},
        "identitySourceKind": {"type": "string", "minLength": 1},
        "evidenceFreshness": {
          "enum": ["FRESH", "STALE", "NOT_AVAILABLE"]
        },
        "evidenceUri": {"type": "string", "minLength": 1},
        "selectionCohort": {"type": "string", "minLength": 1}
      }
    },
    "roleSourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "payload"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "payload": {"$ref": "#/$defs/rolePayload"}
      }
    },
    "roleReviewSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "generatedFromCore",
        "generatedFromClassifier",
        "sourceIdentity",
        "candidates"
      ],
      "properties": {
        "schema": {"const": "ark-kb-role-review-source/v1"},
        "kind": {"const": "role"},
        "generatedFromCore": {"const": false},
        "generatedFromClassifier": {"const": false},
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseSchema",
            "generatedAt",
            "sourceInventoryId",
            "sourceFingerprint",
            "eligibleRowSetSha256",
            "eligibleRowCount",
            "selectedCandidateCount",
            "seed",
            "candidateLimit",
            "selectionRule"
          ],
          "properties": {
            "databaseSchema": {
              "enum": [
                "blueprint-to-code-kb-discovery/v1",
                "blueprint-to-code-kb-discovery/v2"
              ]
            },
            "generatedAt": {"type": "string", "format": "date-time"},
            "sourceInventoryId": {"type": "string", "minLength": 1},
            "sourceFingerprint": {"$ref": "#/$defs/sha256"},
            "eligibleRowSetSha256": {"$ref": "#/$defs/sha256"},
            "eligibleRowCount": {"type": "integer", "minimum": 1},
            "selectedCandidateCount": {"type": "integer", "minimum": 1},
            "seed": {"type": "string", "minLength": 1},
            "candidateLimit": {"type": "integer", "minimum": 1},
            "selectionRule": {"type": "string", "minLength": 1}
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/roleSourceCandidate"}
        }
      }
    },
    "reviewPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packId",
        "kind",
        "authorId",
        "authorKeyFingerprint",
        "createdAt",
        "toolVersion",
        "seed",
        "selectionRule",
        "sourceManifestSha256",
        "candidates",
        "packSha256"
      ],
      "properties": {
        "schema": {"const": "ark-kb-gold-review-pack/v1"},
        "packId": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["query", "registration", "role"]
        },
        "authorId": {"type": "string", "minLength": 1},
        "authorKeyFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "toolVersion": {"type": "string", "minLength": 1},
        "seed": {"type": "string", "minLength": 1},
        "selectionRule": {"type": "string", "minLength": 1},
        "sourceManifestSha256": {"$ref": "#/$defs/sha256"},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "packSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sourceRevisionSha256", "freshness"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sourceRevisionSha256": {"$ref": "#/$defs/sha256"},
        "freshness": {
          "type": "string",
          "enum": ["FRESH", "STALE", "NOT_RECOVERED"]
        }
      }
    },
    "reviewReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packId",
        "packSha256",
        "caseId",
        "candidateSha256",
        "reviewerId",
        "reviewerKeyFingerprint",
        "reviewerRole",
        "round",
        "reviewedAt",
        "verdict",
        "answer",
        "evidence",
        "rationale",
        "toolVersion",
        "contentSha256"
      ],
      "properties": {
        "schema": {"const": "ark-kb-gold-review/v1"},
        "packId": {"type": "string", "minLength": 1},
        "packSha256": {"$ref": "#/$defs/sha256"},
        "caseId": {"type": "string", "minLength": 1},
        "candidateSha256": {"$ref": "#/$defs/sha256"},
        "reviewerId": {"type": "string", "minLength": 1},
        "reviewerKeyFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "reviewerRole": {
          "type": "string",
          "enum": ["REVIEWER", "ADJUDICATOR"]
        },
        "round": {"type": "integer", "minimum": 1},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "verdict": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "REJECTED",
            "EXPECTED_GAP",
            "UNRESOLVED"
          ]
        },
        "answer": {"type": "object"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "rationale": {"type": "string", "minLength": 1},
        "toolVersion": {"type": "string", "minLength": 1},
        "contentSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packId",
        "packSha256",
        "kind",
        "candidateCases",
        "reviewedCases",
        "reviewCount",
        "status",
        "gaps"
      ],
      "properties": {
        "schema": {"const": "ark-kb-gold-review-validation/v1"},
        "packId": {"type": "string", "minLength": 1},
        "packSha256": {"$ref": "#/$defs/sha256"},
        "kind": {
          "type": "string",
          "enum": ["query", "registration", "role"]
        },
        "candidateCases": {"type": "integer", "minimum": 1},
        "reviewedCases": {"type": "integer", "minimum": 0},
        "reviewCount": {"type": "integer", "minimum": 0},
        "status": {
          "type": "string",
          "enum": [
            "READY_TO_FREEZE",
            "BLOCKED_BY_INDEPENDENT_REVIEW"
          ]
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewerRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "reviewers"],
      "properties": {
        "schema": {
          "const": "ark-kb-trusted-reviewer-registry/v1"
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewerKeyFingerprint"
            ],
            "properties": {
              "reviewerId": {"type": "string", "minLength": 1},
              "reviewerKeyFingerprint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "queryReviewProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pack", "reviews"],
      "properties": {
        "schema": {
          "const": "ark-kb-query-review-provenance/v1"
        },
        "pack": {"$ref": "#/$defs/reviewPack"},
        "reviews": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/reviewReceipt"}
        }
      }
    }
  }
}
