{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pityonother.github.io/Blueprint-to-Code/schemas/kb_gold_review_artifact_v2.schema.json",
  "title": "ARK KB artifact-bound Gold review v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packId",
    "packSha256",
    "caseId",
    "candidateSha256",
    "reviewerId",
    "reviewerRole",
    "round",
    "reviewedAt",
    "verdict",
    "answer",
    "evidence",
    "rationale",
    "toolVersion"
  ],
  "properties": {
    "schema": {
      "const": "ark-kb-gold-review-artifact/v2"
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "packSha256": {
      "$ref": "#/$defs/sha256"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "candidateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewerId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerRole": {
      "enum": [
        "REVIEWER",
        "ADJUDICATOR"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "EXPECTED_GAP",
        "UNRESOLVED"
      ]
    },
    "answer": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sourceRevisionSha256",
        "freshness"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevisionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "freshness": {
          "enum": [
            "FRESH",
            "STALE",
            "NOT_RECOVERED"
          ]
        }
      }
    }
  }
}
