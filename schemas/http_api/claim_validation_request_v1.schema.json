{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-to-code.local/schemas/http-api/claim-validation-request/v1",
  "title": "Report claim validation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestPaths"
  ],
  "properties": {
    "manifestPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
      }
    },
    "formal": {
      "type": "boolean"
    }
  }
}
