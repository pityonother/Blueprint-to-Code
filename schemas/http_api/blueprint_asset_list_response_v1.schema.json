{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-to-code.local/schemas/http-api/blueprint-asset-list-response/v1",
  "title": "Blueprint asset list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schema", "items", "page"],
  "properties": {
    "ok": {"const": true},
    "schema": {"const": "blueprint-to-code.blueprint-asset-list-response/v1"},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "health"],
        "properties": {
          "asset": {"type": "string", "minLength": 1, "maxLength": 255},
          "health": {"$ref": "#/$defs/health"}
        }
      }
    },
    "page": {"$ref": "#/$defs/page"}
  },
  "$defs": {
    "maybeRevision": {"type": "string", "pattern": "^(?:$|[0-9a-f]{24})$"},
    "maybeHash": {"type": "string", "pattern": "^(?:$|[0-9a-f]{64})$"},
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "asset", "evidence", "interpretation"],
      "properties": {
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "reasonCode": {"type": "string", "maxLength": 128},
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "assetId", "objectPath"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 255},
            "assetId": {"type": "string", "pattern": "^(?:$|[0-9a-f]{24})$"},
            "objectPath": {"type": "string", "maxLength": 4096}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revisionId", "manifestSha256", "pointerSha256", "freshnessStatus", "releaseAuthority", "migrationRequired"],
          "properties": {
            "revisionId": {"$ref": "#/$defs/maybeRevision"},
            "manifestSha256": {"$ref": "#/$defs/maybeHash"},
            "pointerSha256": {"$ref": "#/$defs/maybeHash"},
            "freshnessStatus": {"type": "string", "maxLength": 64},
            "releaseAuthority": {"type": "boolean"},
            "migrationRequired": {"type": "boolean"}
          }
        },
        "interpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "revisionId", "manifestSha256", "pointerSha256", "semanticDigest", "interpreterVersion", "schemaVersion", "generatedAt"],
          "properties": {
            "status": {"type": "string", "maxLength": 64},
            "revisionId": {"$ref": "#/$defs/maybeRevision"},
            "manifestSha256": {"$ref": "#/$defs/maybeHash"},
            "pointerSha256": {"$ref": "#/$defs/maybeHash"},
            "semanticDigest": {"$ref": "#/$defs/maybeHash"},
            "interpreterVersion": {"type": "string", "maxLength": 128},
            "schemaVersion": {"type": "string", "maxLength": 128},
            "generatedAt": {"type": "string", "maxLength": 128}
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "returned", "total", "nextCursor"],
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "returned": {"type": "integer", "minimum": 0, "maximum": 100},
        "total": {"type": "integer", "minimum": 0},
        "nextCursor": {"type": ["string", "null"], "maxLength": 4096}
      }
    }
  }
}
