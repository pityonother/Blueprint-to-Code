{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-to-code.task-session/v1",
  "title": "Blueprint Task Session v1",
  "type": "object",
  "required": [
    "schema",
    "taskId",
    "phase",
    "taskContextSha256",
    "evidenceIdentities",
    "confirmedKnowledge",
    "openQuestions",
    "patchPlanId",
    "patchPlanSha256",
    "queryLedger",
    "lastVerifiedAt",
    "semanticDigest"
  ],
  "properties": {
    "schema": { "const": "blueprint-to-code.task-session/v1" },
    "taskId": { "type": "string", "pattern": "^task://[0-9a-f]{32}$" },
    "phase": {
      "enum": [
        "DISCOVERY",
        "READY_TO_PLAN",
        "PLAN_DRAFT",
        "PLAN_CONFIRMED",
        "EXECUTION_PENDING",
        "BLOCKED",
        "DONE"
      ]
    },
    "taskContextSha256": { "$ref": "#/$defs/sha256" },
    "evidenceIdentities": { "type": "array", "minItems": 1, "maxItems": 4 },
    "confirmedKnowledge": { "type": "array" },
    "openQuestions": { "type": "array", "maxItems": 20 },
    "patchPlanId": {
      "type": "string",
      "pattern": "^$|^patch-plan://[0-9a-f]{32}$"
    },
    "patchPlanSha256": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "queryLedger": { "type": "object" },
    "lastVerifiedAt": { "type": "string" },
    "semanticDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
