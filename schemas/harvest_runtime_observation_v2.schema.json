{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pityonother.github.io/Blueprint-to-Code/schemas/harvest_runtime_observation_v2.schema.json",
  "title": "Blueprint to Code Harvest runtime ranking observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observationSetId",
    "runtimeProfileId",
    "environmentFingerprint",
    "synthetic",
    "environment",
    "subject",
    "staticModel",
    "trials"
  ],
  "properties": {
    "schema": {"const": "blueprint-to-code.harvest-runtime-observation/v2"},
    "observationSetId": {"type": "string", "pattern": "^runtime://"},
    "runtimeProfileId": {"type": "string", "minLength": 1},
    "environmentFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "synthetic": {"type": "boolean"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameBuild",
        "map",
        "sessionType",
        "HarvestAmountMultiplier",
        "otherHarvestMultipliers",
        "mods",
        "creature",
        "buffs",
        "genes",
        "worldState",
        "nodeFreshnessContract",
        "measurementMethod"
      ],
      "properties": {
        "gameBuild": {"type": "string", "minLength": 1},
        "map": {"type": "string", "minLength": 1},
        "sessionType": {"type": "string", "minLength": 1},
        "HarvestAmountMultiplier": {"type": "number", "minimum": 0},
        "otherHarvestMultipliers": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "mods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        "creature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "meleePercent", "relevantStats"],
          "properties": {
            "level": {"type": "integer", "minimum": 1},
            "meleePercent": {"type": "number", "minimum": 0},
            "relevantStats": {
              "type": "object",
              "propertyNames": {"minLength": 1},
              "additionalProperties": {"type": "number", "minimum": 0}
            }
          }
        },
        "buffs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "genes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "worldState": {
          "type": "object",
          "propertyNames": {"minLength": 1}
        },
        "nodeFreshnessContract": {"type": "string", "minLength": 1},
        "measurementMethod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "randomQuantity", "recommendedSampleCount"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "randomQuantity": {"type": "boolean"},
            "recommendedSampleCount": {"type": "integer", "minimum": 1}
          }
        },
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "nodeResourceId",
        "speciesKey",
        "creatureObjectPath",
        "attackIndex"
      ],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "nodeResourceId": {"type": "string", "minLength": 1},
        "speciesKey": {"type": "string", "minLength": 1},
        "creatureObjectPath": {"type": "string", "pattern": "^/Game/"},
        "attackIndex": {"type": "integer", "minimum": 0}
      }
    },
    "staticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelVersion",
        "extractorVersion",
        "policyVersion",
        "nodeCatalogRevision",
        "evaluationCatalogRevision",
        "componentCatalogRevision"
      ],
      "properties": {
        "modelVersion": {"type": "string", "minLength": 1},
        "extractorVersion": {"type": "string", "minLength": 1},
        "policyVersion": {"type": "string", "minLength": 1},
        "nodeCatalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluationCatalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "componentCatalogRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trialId", "durationSeconds", "hits", "finalResourceUnits"],
        "properties": {
          "trialId": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "hits": {"type": "array", "items": {"type": "object"}},
          "finalResourceUnits": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
