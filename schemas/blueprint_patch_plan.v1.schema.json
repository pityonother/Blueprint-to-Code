{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-to-code.blueprint-patch-plan/v1",
  "title": "Blueprint Patch Plan v1",
  "type": "object",
  "required": [
    "schema",
    "planId",
    "taskId",
    "status",
    "target",
    "capabilityRequirements",
    "nodes",
    "operations",
    "checkpoints",
    "blockingQuestions",
    "semanticDigest"
  ],
  "properties": {
    "schema": { "const": "blueprint-to-code.blueprint-patch-plan/v1" },
    "planId": { "type": "string", "pattern": "^patch-plan://[0-9a-f]{32}$" },
    "taskId": { "type": "string", "pattern": "^task://[0-9a-f]{32}$" },
    "status": { "enum": ["DRAFT", "CONFIRMED"] },
    "target": {
      "type": "object",
      "required": [
        "assetId",
        "objectPath",
        "evidenceRevisionId",
        "evidenceManifestSha256",
        "graphRefs"
      ],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "objectPath": { "type": "string", "pattern": "^/(Game|Engine|Script)/" },
        "evidenceRevisionId": { "type": "string", "minLength": 1 },
        "evidenceManifestSha256": { "$ref": "#/$defs/sha256" },
        "graphRefs": { "type": "array", "minItems": 1, "maxItems": 2 }
      }
    },
    "capabilityRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "nodes": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
    "operations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "kind",
          "graphRef",
          "dependsOn",
          "preconditions",
          "payload",
          "postconditions",
          "checkpoint"
        ],
        "properties": {
          "operationId": { "type": "string", "pattern": "^op://" },
          "kind": {
            "enum": [
              "CREATE_NODE",
              "DELETE_NODE",
              "CONNECT",
              "DISCONNECT",
              "SET_DEFAULT",
              "MOVE_NODE",
              "ADD_COMMENT",
              "PRESERVE"
            ]
          },
          "graphRef": { "type": "string", "pattern": "^bp://" },
          "dependsOn": { "type": "array", "maxItems": 128 },
          "preconditions": { "type": "array" },
          "payload": { "type": "object" },
          "postconditions": { "type": "array" },
          "checkpoint": { "type": "string" }
        }
      }
    },
    "checkpoints": { "type": "array", "maxItems": 32 },
    "blockingQuestions": { "type": "array", "maxItems": 20 },
    "semanticDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
