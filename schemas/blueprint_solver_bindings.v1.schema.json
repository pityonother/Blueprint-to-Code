{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-to-code.solver-bindings/v1",
  "title": "Blueprint Solver Bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "solverId", "assets", "tasks", "pendingTasks", "aliases", "datasetDescriptors", "localizationDescriptors", "modAssetDescriptors", "resolvedBlockingQuestions", "semanticDigest"],
  "properties": {
    "schema": {"const": "blueprint-to-code.solver-bindings/v1"},
    "solverId": {"type": "string", "pattern": "^solver://[0-9a-f]{32}$"},
    "assets": {
      "type": "object", "maxProperties": 8,
      "propertyNames": {"pattern": "^problem://[0-9a-f]{24}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["asset"],
        "properties": {
          "asset": {"type": "string", "minLength": 1, "maxLength": 256},
          "assetId": {"type": "string", "maxLength": 128},
          "objectPath": {"type": "string", "maxLength": 512},
          "evidenceRevisionId": {"type": "string", "maxLength": 128},
          "evidenceManifestSha256": {"type": "string", "maxLength": 64},
          "freshness": {"type": "string", "maxLength": 64},
          "graphTargets": {"type": "array", "maxItems": 32, "items": {"type": "object", "maxProperties": 16}},
          "graphRef": {"type": "string", "maxLength": 4096}
        }
      }
    },
    "tasks": {
      "type": "object", "maxProperties": 8,
      "propertyNames": {"pattern": "^problem://[0-9a-f]{24}$"},
      "additionalProperties": {"type": "string", "pattern": "^task://[0-9a-f]{32}$"}
    },
    "pendingTasks": {
      "type": "object", "maxProperties": 8,
      "propertyNames": {"pattern": "^problem://[0-9a-f]{24}$"},
      "additionalProperties": {"type": "string", "pattern": "^task://[0-9a-f]{32}$"}
    },
    "aliases": {
      "type": "object", "maxProperties": 64,
      "additionalProperties": {
        "type": "array", "maxItems": 8, "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "datasetDescriptors": {"$ref": "#/$defs/descriptors"},
    "localizationDescriptors": {"$ref": "#/$defs/descriptors"},
    "modAssetDescriptors": {"$ref": "#/$defs/descriptors"},
    "resolvedBlockingQuestions": {
      "type": "object", "maxProperties": 32,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "semanticDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "descriptors": {
      "type": "object", "maxProperties": 8,
      "propertyNames": {"pattern": "^problem://[0-9a-f]{24}$"},
      "additionalProperties": {"type": "object", "minProperties": 1, "maxProperties": 32}
    }
  }
}
